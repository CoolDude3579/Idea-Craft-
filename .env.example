# All optional. The prototype runs with none of these set.

# Neon / Postgres. Unset: ideas and pins live in process memory.
DATABASE_URL=

# Openverse registered client. Anonymous is 20/min, 200/day (verified from
# response headers) — enough for a demo, but set these for a live audience.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# OpenAlex polite pool. 100k credits/day; a 20-result list query costs 10.
OPENALEX_MAILTO=

# 1 = serve offline placeholder records instead of calling the providers.
DEMO_FIXTURES=
